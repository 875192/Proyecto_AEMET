# Copia este archivo como ".env" y cambia los valores.
# NO subas el .env ni la API key a repositorios públicos.

MYSQL_ROOT_PASSWORD=cambia_esta_root
MYSQL_DATABASE=meteo_aemet
MYSQL_USER=meteo
MYSQL_PASSWORD=cambia_esta_password

# Conexión MySQL para Node.js (debe coincidir con los valores de arriba)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meteo_aemet
DB_USER=meteo
DB_PASSWORD=cambia_esta_password

# Clave de AEMET OpenData (la usará el script de Node.js)
AEMET_API_KEY=pega_aqui_tu_api_key

# Rango de fechas opcional (formato YYYY-MM-DD). Si no se definen, se usan los últimos 30 días.
# FECHA_INI=2026-10-01
# FECHA_FIN=2026-10-31
