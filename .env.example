# Copia este archivo como ".env" y cambia los valores.
# NO subas el .env ni la API key a repositorios públicos.

MYSQL_ROOT_PASSWORD=cambia_esta_root
MYSQL_DATABASE=meteo_aemet
MYSQL_USER=meteo
MYSQL_PASSWORD=cambia_esta_password

# Conexión MySQL para Node.js (debe coincidir con los valores de arriba)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meteo_aemet
DB_USER=meteo
DB_PASSWORD=cambia_esta_password

# Clave de AEMET OpenData (la usará el script de Node.js)
AEMET_API_KEY=pega_aqui_tu_api_key

# Rango de fechas opcional (formato YYYY-MM-DD). Si no se definen, se descargan los últimos
# HISTORICO_ANIOS años (10 por defecto) hasta hoy.
# FECHA_INI=2016-01-01
# FECHA_FIN=2026-10-31
# HISTORICO_ANIOS=10

# Ajustes opcionales de la descarga (valores por defecto entre paréntesis)
# TRAMO_DIAS=180        # días por petición; AEMET limita a 6 meses
# PAUSA_MS=1500         # pausa entre tramos
# MAX_INTENTOS=5        # reintentos ante 429, errores 5xx o fallos de red
# ESPERA_429_MS=60000   # espera tras superar el límite de peticiones por minuto
# ESPERA_ERROR_MS=5000  # espera base ante errores (se multiplica por el nº de intento)

# Actualización automática diaria (la hace el servicio "etl" de docker-compose)
# HORA_ACTUALIZACION=00:30     # hora local (HH:MM) a la que se lanza cada día
# EJECUTAR_AL_ARRANCAR=true    # si es "false", no actualiza al arrancar y espera a la hora programada
