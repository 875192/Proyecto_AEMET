# Copia este archivo como ".env" y cambia los valores.
# NO subas el .env ni la API key a repositorios públicos.

MYSQL_ROOT_PASSWORD=cambia_esta_root
MYSQL_DATABASE=meteo_aemet
MYSQL_USER=meteo
MYSQL_PASSWORD=cambia_esta_password

# Clave de AEMET OpenData (la usará el script de Node.js)
AEMET_API_KEY=pega_aqui_tu_api_key
